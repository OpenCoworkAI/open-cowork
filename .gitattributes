# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows-specific scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - no text conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.exe binary
*.dll binary
*.node binary
*.sqlite binary
*.db binary

# Lock files - enforce LF to prevent cross-platform false diffs
package-lock.json text eol=lf

